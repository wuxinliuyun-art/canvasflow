{
  "name": "canvasflow",
  "version": "2.5.0",
  "description": "CanvasFlow visual AI image workflow",
  "author": "wuxinliuyun-art",
  "license": "MIT",
  "repository": "https://github.com/wuxinliuyun-art/canvasflow",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "start:server": "node server.js",
    "build:windows": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^37.2.4",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "art.wuxinliuyun.canvasflow",
    "productName": "CanvasFlow",
    "artifactName": "CanvasFlow-Setup.exe",
    "files": [
      "electron/**/*",
      "index.html",
      "app.js",
      "styles.css",
      
      "server.js",
      "package.json",
      "LICENSE"
    ],
    "directories": { "output": "dist" },
    "asar": true,
    "win": { "target": ["nsis"] },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
