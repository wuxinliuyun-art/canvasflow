<Window x:Class="CanvasFlow.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
 Title="CanvasFlow" Width="1440" Height="900" MinWidth="960" MinHeight="640"
 WindowStartupLocation="CenterScreen" Background="White">
  <Grid>
    <wv2:WebView2 x:Name="CanvasView" DefaultBackgroundColor="White"/>
    <Border x:Name="StartupOverlay" Background="#EFFFFFFF">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <ProgressBar Width="220" Height="4" IsIndeterminate="True" Foreground="#2563EB"/>
        <TextBlock x:Name="StatusText" Text="正在启动 CanvasFlow…" Margin="0,14,0,0"
         HorizontalAlignment="Center" Foreground="#374151" FontSize="14"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
