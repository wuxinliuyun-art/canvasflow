<Window x:Class="CanvasFlow.Desktop.ScreenshotToolWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="CanvasFlow 截图工具" Width="428" Height="720" MinWidth="390" MinHeight="172"
 WindowStartupLocation="Manual" ResizeMode="CanResizeWithGrip" Background="{DynamicResource WindowBackgroundBrush}"
 FontFamily="HarmonyOS Sans SC, Microsoft YaHei UI" FontSize="13"
 Closing="Window_Closing" LocationChanged="Window_StateChanged" SizeChanged="Window_StateChanged">
  <Window.Resources>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F4F5F6"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#E0E2E5"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#202226"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#7D828A"/>
    <SolidColorBrush x:Key="PreviewBackgroundBrush" Color="#F4F5F6"/>
    <SolidColorBrush x:Key="StatusBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#EDEEF0"/>
    <SolidColorBrush x:Key="HoverTextBrush" Color="#202226"/>
    <SolidColorBrush x:Key="PrimaryButtonBrush" Color="#27292D"/>
    <SolidColorBrush x:Key="PrimaryButtonTextBrush" Color="#FFFFFF"/>
    <Style TargetType="Button">
      <Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="13,5"/>
      <Setter Property="Margin" Value="0,0,6,0"/><Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonBorder" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/><Setter Property="Foreground" Value="{DynamicResource HoverTextBrush}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="HeaderToggleButtonStyle" TargetType="ToggleButton">
      <Setter Property="Width" Value="36"/><Setter Property="Height" Value="32"/><Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/><Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="ToggleBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource PrimaryButtonBrush}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryButtonTextBrush}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ToggleBorder" Property="Opacity" Value="0.78"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Height" Value="28"/><Setter Property="Margin" Value="0,3,0,7"/><Setter Property="Padding" Value="7,1"/><Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/><Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <ToggleButton x:Name="DropDownToggle" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="ComboBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><ContentPresenter Grid.Column="0" Margin="7,0,2,0" HorizontalAlignment="Left" VerticalAlignment="Center" Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}" TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}"/><Path Grid.Column="1" Width="7" Height="4" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}" Data="M 0 0 L 7 0 L 3.5 4 Z"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboBorder" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="260" Margin="0,2,0,0" Padding="2" Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="MinHeight" Value="26"/><Setter Property="Padding" Value="7,3"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/><Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemBorder" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="3"><ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/><Setter Property="Foreground" Value="{DynamicResource HoverTextBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource PrimaryButtonBrush}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryButtonTextBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/><Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,8"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/></Style>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/></Style>
  </Window.Resources>
  <Grid Margin="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <TextBlock x:Name="RegionStatus" Grid.Row="0" Margin="2,0,0,8" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Text="尚未设置截图区域"/>

    <Grid Grid.Row="1" Margin="0,0,0,10">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition x:Name="ParametersButtonColumn"/><ColumnDefinition Width="40"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
      <Button x:Name="CaptureButton" Grid.Column="0" Content="截图" Click="CaptureButton_Click"/>
      <Button x:Name="SendButton" Grid.Column="1" Background="{DynamicResource PrimaryButtonBrush}" Foreground="{DynamicResource PrimaryButtonTextBrush}" Content="发送任务" Click="SendButton_Click"/>
      <Button x:Name="ParametersToggleButton" Grid.Column="2" Content="显示参数" Click="ParametersToggleButton_Click"/>
      <ToggleButton x:Name="TopmostToggle" Grid.Column="3" Width="36" Height="36" Margin="0,0,4,0" Style="{StaticResource HeaderToggleButtonStyle}" ToolTip="置顶窗口" Checked="TopmostToggle_Changed" Unchecked="TopmostToggle_Changed"><Viewbox Width="15" Height="15"><Canvas Width="24" Height="24"><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M8 4h8M9 4l1 6-3 3h10l-3-3 1-6M12 13v7"/></Canvas></Viewbox></ToggleButton>
      <Button x:Name="CollapseButton" Grid.Column="4" Width="36" Height="36" Margin="0" Padding="0" Content="−" FontSize="16" ToolTip="折叠或展开" Click="CollapseButton_Click"/>
    </Grid>

    <StackPanel Grid.Row="2">
      <CheckBox x:Name="UseCanvasNodeToggle" Margin="2,0,0,8" Content="使用画布节点输入" Checked="UseCanvasNodeToggle_Changed" Unchecked="UseCanvasNodeToggle_Changed"/>
      <CheckBox x:Name="AutoCaptureToggle" Margin="2,0,0,8" Content="发送前自动使用已保存区域重新截图" Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed"/>
      <Border x:Name="CanvasNodePanel" Visibility="Collapsed" Padding="10" Margin="0,0,0,10" CornerRadius="10" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <StackPanel><TextBlock Margin="0,0,0,4" Text="截图功能节点"/><ComboBox x:Name="CanvasNodeCombo" Width="Auto" HorizontalAlignment="Stretch" SelectedValuePath="Id" SelectionChanged="CanvasNodeCombo_SelectionChanged"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock x:Name="CanvasNodeSummary" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap"/></StackPanel>
      </Border>
    </StackPanel>

    <Border x:Name="AdvancedPanel" Grid.Row="3" Padding="12" Margin="0,0,0,10" CornerRadius="10" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
      <StackPanel>
        <TextBlock Text="默认提示词"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="PromptCombo" Grid.Column="0" MinWidth="150" HorizontalAlignment="Stretch" SelectedValuePath="Id" SelectionChanged="PromptCombo_SelectionChanged"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><Button Grid.Column="1" MinHeight="28" Height="28" Margin="6,3,0,7" Padding="10,2" Content="刷新" Click="RefreshPromptsButton_Click"/><Button x:Name="SavePromptButton" Grid.Column="2" MinHeight="28" Height="28" Margin="6,3,0,7" Padding="10,2" Content="保存提示词" Click="SavePromptButton_Click"/></Grid>
        <TextBlock Margin="0,0,0,5" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Text="可在模板基础上继续编辑，本窗口会记住修改内容"/>
        <TextBox x:Name="PromptTextBox" MinHeight="88" MaxHeight="150" Margin="0,0,0,7" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="PromptTextBox_TextChanged"/>
        <StackPanel>
          <StackPanel>
            <WrapPanel>
              <StackPanel Width="176" Margin="0,0,12,0"><TextBlock Text="模型"/><ComboBox x:Name="ModelCombo" Width="166" SelectionChanged="SettingsControl_Changed"><ComboBoxItem Tag="gpt-image-2">GPT Image 2</ComboBoxItem><ComboBoxItem Tag="gemini-3.1-flash-image-preview">Gemini 3.1 Flash</ComboBoxItem></ComboBox></StackPanel>
              <StackPanel Width="92" Margin="0,0,12,0"><TextBlock Text="分辨率"/><ComboBox x:Name="ResolutionCombo" Width="82" SelectionChanged="SettingsControl_Changed"><ComboBoxItem Tag="1k">1K</ComboBoxItem><ComboBoxItem Tag="2k">2K</ComboBoxItem><ComboBoxItem Tag="4k">4K</ComboBoxItem></ComboBox></StackPanel>
              <StackPanel x:Name="QualityField" Width="92"><TextBlock Text="画质"/><ComboBox x:Name="QualityCombo" Width="82" SelectionChanged="SettingsControl_Changed"><ComboBoxItem Tag="low">low</ComboBoxItem><ComboBoxItem Tag="medium">medium</ComboBoxItem><ComboBoxItem Tag="high">high</ComboBoxItem></ComboBox></StackPanel>
              <StackPanel Width="92" Margin="0,0,12,0"><TextBlock Text="比例"/><ComboBox x:Name="RatioCombo" Width="82" SelectionChanged="SettingsControl_Changed"><ComboBoxItem Tag="1:1">1:1</ComboBoxItem><ComboBoxItem Tag="auto">auto</ComboBoxItem><ComboBoxItem Tag="3:2">3:2</ComboBoxItem><ComboBoxItem Tag="2:3">2:3</ComboBoxItem><ComboBoxItem Tag="4:3">4:3</ComboBoxItem><ComboBoxItem Tag="3:4">3:4</ComboBoxItem><ComboBoxItem Tag="5:4">5:4</ComboBoxItem><ComboBoxItem Tag="4:5">4:5</ComboBoxItem><ComboBoxItem Tag="16:9">16:9</ComboBoxItem><ComboBoxItem Tag="9:16">9:16</ComboBoxItem><ComboBoxItem Tag="2:1">2:1</ComboBoxItem><ComboBoxItem Tag="1:2">1:2</ComboBoxItem><ComboBoxItem Tag="3:1">3:1</ComboBoxItem><ComboBoxItem Tag="1:3">1:3</ComboBoxItem><ComboBoxItem Tag="21:9">21:9</ComboBoxItem><ComboBoxItem Tag="9:21">9:21</ComboBoxItem></ComboBox></StackPanel>
              <StackPanel Width="92"><TextBlock Text="生成数量"/><ComboBox x:Name="CountCombo" Width="82" SelectionChanged="SettingsControl_Changed"><ComboBoxItem Tag="1">1</ComboBoxItem><ComboBoxItem Tag="2">2</ComboBoxItem><ComboBoxItem Tag="3">3</ComboBoxItem><ComboBoxItem Tag="4">4</ComboBoxItem></ComboBox></StackPanel>
            </WrapPanel>
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </Border>

    <Grid x:Name="PreviewPanel" Grid.Row="4">
      <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Button x:Name="PreviewSwitchButton" Grid.Column="0" Width="24" MinHeight="0" Margin="0,0,4,0" Padding="0" Content="›" ToolTip="切换最近截图/生成结果" Click="PreviewSwitchButton_Click"/>
      <Border x:Name="CapturePreviewCard" Grid.Column="1" Padding="7" CornerRadius="9" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Margin="2,0,0,6" FontWeight="SemiBold" Text="最近截图"/><Border Grid.Row="1" Background="{DynamicResource PreviewBackgroundBrush}" CornerRadius="6" Cursor="Hand" ToolTip="双击放大" MouseLeftButtonDown="CapturePreview_MouseLeftButtonDown"><Image x:Name="CapturePreview" Stretch="Uniform" IsHitTestVisible="False"/></Border></Grid>
      </Border>
      <Border x:Name="ResultPreviewCard" Grid.Column="1" Visibility="Collapsed" Padding="7" CornerRadius="9" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Margin="2,0,0,6" FontWeight="SemiBold" Text="生成结果"/><Border Grid.Row="1" Background="{DynamicResource PreviewBackgroundBrush}" CornerRadius="6" Cursor="Hand" ToolTip="双击放大；右键可复制图片" MouseLeftButtonDown="ResultPreview_MouseLeftButtonDown"><Border.ContextMenu><ContextMenu><MenuItem Header="复制图片" Click="CopyResultImageMenuItem_Click"/></ContextMenu></Border.ContextMenu><Image x:Name="ResultPreview" Stretch="Uniform" IsHitTestVisible="False"/></Border><StackPanel Grid.Row="2" Margin="0,6,0,0" Orientation="Horizontal" HorizontalAlignment="Center"><Button x:Name="PreviousResultButton" Width="34" MinHeight="26" Padding="0" Content="‹" Click="PreviousResultButton_Click"/><TextBlock x:Name="ResultIndexText" Width="48" TextAlignment="Center" VerticalAlignment="Center" Text="0 / 0"/><Button x:Name="NextResultButton" Width="34" MinHeight="26" Margin="0" Padding="0" Content="›" Click="NextResultButton_Click"/></StackPanel></Grid>
      </Border>
    </Grid>

    <Border Grid.Row="5" Margin="0,10,0,0" Padding="10,7" CornerRadius="8" Background="{DynamicResource StatusBackgroundBrush}"><TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="12" Text="准备就绪"/></Border>
  </Grid>
</Window>
