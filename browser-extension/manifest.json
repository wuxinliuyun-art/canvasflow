{
  "manifest_version": 3,
  "name": "CanvasFlow 浏览器生图桥",
  "version": "1.0.4",
  "description": "把 CanvasFlow 画布的提示词和参考图送到 Gemini / ChatGPT 等网页对话，模拟人工操作并把生成图片带回画布。支持手动校准任意站点的输入框与发送按钮。",
  "permissions": ["storage", "scripting", "activeTab", "tabs", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CanvasFlow 浏览器生图"
  },
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*", "https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
